# Co-op alone needs NONE of these — deploy the service and it just works.
# Fill these in only when you want the Stripe coin store switched on.

# Stripe (dashboard -> Developers -> API keys)
STRIPE_SECRET_KEY=sk_live_or_test_xxx
# Created when you add the webhook endpoint in Stripe (see BACKEND.md)
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Supabase — the SERVICE ROLE key, not the anon key. Server-side only. Never ship it to the browser.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# optional
CURRENCY=usd
ALLOW_ORIGIN=*
